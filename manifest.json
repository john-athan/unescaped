{
  "manifest_version": 3,
  "name": "Unescaped - Render HTML Source as a Page",
  "short_name": "Unescaped",
  "version": "0.1.0",
  "description": "Opens HTML source as a working page in a new tab: a selection, a raw .html file, or an HTML file in Google Drive.",
  "homepage_url": "https://github.com/john-athan/unescaped",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["https://drive.google.com/*", "https://drive.usercontent.google.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Unescaped: render this as a page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Render the selection, the Drive file, or the raw page"
    }
  },
  "sandbox": { "pages": ["sandbox.html"] }
}
